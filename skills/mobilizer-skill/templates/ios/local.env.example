# Copy is created as mobile/ios/local.env by bin/install (gitignored). Per-machine settings, NOT secrets.
# Apple Developer Team ID: Xcode > Settings > Accounts > select your team > Team ID
# (a free "Personal Team" ID works for `bin/run-device --free`).
TEAM_ID=
# Optional: device name or UDID (see `xcrun devicectl list devices`). Empty = the only connected iPhone.
DEVICE=
# Optional: simulator name pattern for bin/run-simulator, e.g. "iPhone 17 Pro". Empty = first available recent iPhone.
SIMULATOR=
