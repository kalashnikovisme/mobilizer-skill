#!/usr/bin/env bash
#
# Archive the RELEASE build (bundle {{APP_ID}}) and upload it to App Store Connect / TestFlight.
# Needs the PAID Apple Developer team and the app record in App Store Connect.
# Build number = timestamp (yymmddHHMM), so it always increases.
#
# Usage: mobile/ios/bin/testflight
# After the upload, processing in App Store Connect takes ~10-30 minutes before the build
# appears under TestFlight; then add testers there.
set -euo pipefail
cd "$(dirname "$0")/../.."   # mobile/
[ "$(uname)" = "Darwin" ] || { echo "macOS only." >&2; exit 1; }
[ -f ios/local.env ] || { echo "mobile/ios/local.env missing -- run mobile/ios/bin/install" >&2; exit 1; }
set -a; . ios/local.env; set +a
[ -n "${TEAM_ID:-}" ] || { echo "Set TEAM_ID (paid team) in mobile/ios/local.env" >&2; exit 1; }
[ -d node_modules ] || {{MOBILE_NPM}} ci
{{MOBILE_CAP}} sync ios            # NO CAP_DEBUG: release builds keep WebView debugging off
BUILD=$(date +%y%m%d%H%M)
ARCHIVE="ios/build/{{APP_PASCAL}}.xcarchive"
mkdir -p ios/build; rm -rf "$ARCHIVE"
cat > ios/build/ExportOptions.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>method</key><string>app-store-connect</string>
<key>destination</key><string>upload</string>
<key>teamID</key><string>$TEAM_ID</string>
<key>signingStyle</key><string>automatic</string>
</dict></plist>
PLIST
xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release \
  -destination 'generic/platform=iOS' -archivePath "$ARCHIVE" \
  -allowProvisioningUpdates DEVELOPMENT_TEAM="$TEAM_ID" CURRENT_PROJECT_VERSION="$BUILD" archive
[ -d "$ARCHIVE" ] || { echo "Archive was not created." >&2; exit 1; }
xcodebuild -exportArchive -archivePath "$ARCHIVE" \
  -exportOptionsPlist ios/build/ExportOptions.plist -allowProvisioningUpdates
echo "Uploaded build $BUILD. It appears in App Store Connect > TestFlight after processing (~10-30 min)."
